  transaction_id      String              @db.Uuid
  account_id          String              @db.Uuid
  direction           entry_direction
  amount              BigInt
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  ledger_accounts     ledger_accounts     @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger_transactions ledger_transactions @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, created_at], map: "ix_ledger_entries_account")
  @@index([transaction_id], map: "ix_ledger_entries_tx")
  @@schema("fin")
}

model ledger_transactions {
  id                        String                @id @db.Uuid
  kind                      String
  description               String?
  occurred_at               DateTime              @db.Timestamptz(6)
  order_id                  String?               @db.Uuid
  purchase_order_id         String?               @db.Uuid
  payment_intent_id         String?               @db.Uuid
  refund_id                 String?               @db.Uuid
  settlement_id             String?               @db.Uuid
  payout_id                 String?               @db.Uuid
  reverses_transaction_id   String?               @db.Uuid
  created_by_staff_id       String?               @db.Uuid
  idempotency_key           String                @unique
  created_at                DateTime              @default(now()) @db.Timestamptz(6)
  ledger_entries            ledger_entries[]
  staff_users               staff_users?          @relation(fields: [created_by_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                    orders?               @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_intents           payment_intents?      @relation(fields: [payment_intent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payouts                   payouts?              @relation(fields: [payout_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders           purchase_orders?      @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds                   refunds?              @relation(fields: [refund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger_transactions       ledger_transactions?  @relation("ledger_transactionsToledger_transactions", fields: [reverses_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_ledger_transactions ledger_transactions[] @relation("ledger_transactionsToledger_transactions")
  settlements               settlements?          @relation(fields: [settlement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([occurred_at], map: "ix_ledger_tx_time")
  @@schema("fin")
}

