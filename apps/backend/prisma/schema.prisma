generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit", "cms", "core", "customs", "files", "fin", "freight", "identity", "mkt", "msg", "ops", "org", "public", "ref", "reporting", "svc", "sys", "transport", "warehouse"]
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model audit_logs {
  id               String     @db.Uuid
  occurred_at      DateTime   @default(now()) @db.Timestamptz(6)
  actor_type       actor_type
  actor_user_id    String?    @db.Uuid
  actor_staff_id   String?    @db.Uuid
  actor_org_id     String?    @db.Uuid
  action           String
  entity_type      String
  entity_id        String?    @db.Uuid
  entity_reference String?
  before           Json?
  after            Json?
  reason           String?
  ip               String?    @db.Inet
  user_agent       String?
  request_id       String?

  @@id([id, occurred_at])
  @@index([action, occurred_at(sort: Desc)], map: "ix_audit_action")
  @@index([entity_type, entity_id, occurred_at(sort: Desc)], map: "ix_audit_entity")
  @@schema("audit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model banners {
  id                  String           @id @db.Uuid
  title_ar            String
  title_en            String
  body_ar             String?
  body_en             String?
  image_file_id       String?          @db.Uuid
  deep_link           String?
  workspaces          workspace_type[]
  city_ids            String[]         @default([]) @db.Uuid
  service_types       service_type[]   @default([])
  starts_at           DateTime         @db.Timestamptz(6)
  ends_at             DateTime?        @db.Timestamptz(6)
  priority            Int              @default(100) @db.SmallInt
  is_dismissible      Boolean          @default(true)
  is_active           Boolean          @default(true)
  created_by_staff_id String?          @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  staff_users         staff_users?     @relation(fields: [created_by_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files               files?           @relation(fields: [image_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("cms")
}

model broadcasts {
  id                  String                 @id @db.Uuid
  title_ar            String
  title_en            String
  body_ar             String
  body_en             String
  deep_link           String?
  segment             Json
  channels            notification_channel[]
  is_marketing        Boolean                @default(false)
  scheduled_at        DateTime?              @db.Timestamptz(6)
  status              broadcast_status       @default(DRAFT)
  estimated_reach     Int?
  sent_count          Int                    @default(0)
  approval_id         String?                @db.Uuid
  created_by_staff_id String                 @db.Uuid
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  updated_at          DateTime               @default(now()) @db.Timestamptz(6)
  pending_approvals   pending_approvals?     @relation(fields: [approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_users         staff_users            @relation(fields: [created_by_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("cms")
}

model faqs {
  id                  String           @id @db.Uuid
  category_key        String
  question_ar         String
  question_en         String
  answer_ar           String
  answer_en           String
  workspaces          workspace_type[] @default([CUSTOMER, SUPPLIER, PROVIDER, DRIVER])
  sort_order          Int              @default(0)
  is_active           Boolean          @default(true)
  updated_by_staff_id String?          @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  staff_users         staff_users?     @relation(fields: [updated_by_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("cms")
}

model reference_sequences {
  prefix      String
  year_suffix String
  last_value  BigInt @default(0)

  @@id([prefix, year_suffix])
  @@schema("core")
}

