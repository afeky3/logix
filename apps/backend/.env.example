NODE_ENV=local
PORT=3001

# Local: docker compose Postgres. Dev/staging/prod: see planning/SERVER-DETAILS.md
DATABASE_URL="postgresql://logix_app:CHANGEME@127.0.0.1:5432/logix"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_KEY_PREFIX=logix:

JWT_ACCESS_SECRET=CHANGEME_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGEME_32_CHARS_MIN

APP_VERSION_MIN_IOS=1.0.0
APP_VERSION_MIN_ANDROID=1.0.0

# T-04 (real SMS provider) is still open. Until then OTPs can be delivered
# over WhatsApp via a self-hosted Evolution API instance. Leave channel as
# "fake" (OTP only logged, OTP_TEST_CODE works for every phone) unless you
# have an Evolution API instance to point at.
OTP_DELIVERY_CHANNEL=fake
# EVOLUTION_API_BASE_URL=https://evo-wa.msaratech.com
# EVOLUTION_API_KEY=CHANGEME
# EVOLUTION_INSTANCE=CHANGEME
